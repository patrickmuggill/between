# Copy to .env.local, or run npm run setup for a hidden key prompt.
# Keep real keys out of source control. The browser never receives this value.
OPENAI_API_KEY=

# Optional: use models available to your OpenAI API account.
# OPENAI_DECISION_MODEL=gpt-6-luna
# OPENAI_GENERATION_MODEL=gpt-6-luna

# Optional local port. The server always binds to 127.0.0.1.
# PORT=4173
